# Claude Code session data (contains credentials, local history) - never commit
.claude_session/
.claude/
.bkit

# Data CSVs/embeddings/model artifacts (real device/user identifiers, large binaries) - never commit
data/

# Python virtualenv
.venv/
__pycache__/
*.pyc

# AWS access keys - never commit (config/ 의 IAM 정책 JSON/예시는 추적한다)
config/*accessKeys*
config/*.pem

# OS cruft
.DS_Store
Thumbs.db
