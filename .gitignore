# Claude Code session data (contains credentials, local history) - never commit
.claude_session/
.claude/
.bkit

# Data CSVs/embeddings/model artifacts (real device/user identifiers, large binaries) - never commit
data/

# Python virtualenv
.venv/
__pycache__/
*.pyc

# Local config (may contain machine-specific paths) - example files are tracked explicitly
seed/config/*
!seed/config/train_config.example.json
postback/config/*
!postback/config/train_config.example.json

# OS cruft
.DS_Store
Thumbs.db
